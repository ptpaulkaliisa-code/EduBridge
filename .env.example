# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...    # Server-only, never expose to client

# Africa's Talking
AT_API_KEY=your_api_key_here
AT_USERNAME=sandbox                     # or your live username
AT_SENDER_ID=EduBridge

# Supabase Auth "Send SMS Hook" — routes phone OTP delivery through
# Africa's Talking (src/app/api/auth/sms-hook) instead of Twilio. Must
# match the secret configured on the project's hook_send_sms_secrets.
SEND_SMS_HOOK_SECRET=v1,whsec_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=random_secret_for_cron_auth  # Protect cron endpoints

# Phase 2 — Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx

# Optional
RESEND_API_KEY=re_xxxx    # Email notifications
